# Solo infra prod. Copiar a /opt/portal-facturacion-configs/.env.prod en el servidor (chmod 600).
# Los secretos/credenciales (BD, JWT, correo, FuDo) viven en
# /opt/portal-facturacion-configs/configuracion-general.yml.
# No poner secretos aquí. APP_DOMAIN lo usa Caddy ({$APP_DOMAIN}).
# TAG lo pone el workflow del API en cada deploy; WEB_TAG lo pone el workflow
# de la web. Se dejan aquí solo como fallback local.
IMAGE_OWNER=tu-organizacion-github
TAG=latest
WEB_IMAGE_OWNER=tu-organizacion-github
WEB_TAG=latest
APP_DOMAIN=tudominio.com


