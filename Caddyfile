# Responde en cualquier hostname (:80): el hostname público del EC2 cambia
# si la instancia se reinicia sin IP elástica, y APP_DOMAIN puede no coincidir.
# Cuando tengas dominio propio con registro A, cambia :80 por {$APP_DOMAIN}
# (sin prefijo http://) y Caddy emitirá el certificado https automáticamente.
:80 {
	handle /api/* {
		reverse_proxy api:8080
	}
	handle /actuator/* {
		reverse_proxy api:8080
	}
	handle /v3/* {
		reverse_proxy api:8080
	}
	handle /swagger-ui* {
		reverse_proxy api:8080
	}
	handle {
		reverse_proxy web:80
	}
}
